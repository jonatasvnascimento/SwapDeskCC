<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Mesmas cores do protótipo (teste/style.css) -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="WinColor">#EBF3F3F3</Color>
      <Color x:Key="WinSolidColor">#F3F3F3</Color>
      <SolidColorBrush x:Key="WinBrush" Color="#EBF3F3F3" />
      <SolidColorBrush x:Key="WinSolidBrush" Color="#F3F3F3" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Surface2Brush" Color="#F6F6F6" />
      <SolidColorBrush x:Key="LineBrush" Color="#14000000" />
      <SolidColorBrush x:Key="HoverBrush" Color="#0F000000" />
      <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B" />
      <SolidColorBrush x:Key="MutedBrush" Color="#616161" />
      <SolidColorBrush x:Key="OkBrush" Color="#0F7B0F" />
      <SolidColorBrush x:Key="WarnBrush" Color="#9D5D00" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#59000000" />
      <BoxShadows x:Key="CardShadow">0 20 50 0 #2E000000</BoxShadows>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="WinColor">#EB202020</Color>
      <Color x:Key="WinSolidColor">#202020</Color>
      <SolidColorBrush x:Key="WinBrush" Color="#EB202020" />
      <SolidColorBrush x:Key="WinSolidBrush" Color="#202020" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B2B" />
      <SolidColorBrush x:Key="Surface2Brush" Color="#252525" />
      <SolidColorBrush x:Key="LineBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="HoverBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="TextBrush" Color="#F3F3F3" />
      <SolidColorBrush x:Key="MutedBrush" Color="#A8A8A8" />
      <SolidColorBrush x:Key="OkBrush" Color="#6CCB5F" />
      <SolidColorBrush x:Key="WarnBrush" Color="#FCE100" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#80000000" />
      <BoxShadows x:Key="CardShadow">0 20 50 0 #80000000</BoxShadows>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <Color x:Key="AccentColor">#C96442</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="#C96442" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#B8583A" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#A34E33" />
  <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />

  <!-- O tema Fluent usa estas cores em checkbox, foco etc. -->
  <Color x:Key="SystemAccentColor">#C96442</Color>
  <Color x:Key="SystemAccentColorLight1">#D57A5C</Color>
  <Color x:Key="SystemAccentColorLight2">#E09276</Color>
  <Color x:Key="SystemAccentColorLight3">#EBAB92</Color>
  <Color x:Key="SystemAccentColorDark1">#B8583A</Color>
  <Color x:Key="SystemAccentColorDark2">#A34E33</Color>
  <Color x:Key="SystemAccentColorDark3">#8C432C</Color>

