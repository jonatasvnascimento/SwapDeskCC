<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SwapDeskCC.App.ViewModels"
             x:Class="SwapDeskCC.App.Views.AccountsPage"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,24">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Classes="h1" Text="Contas" />
          <TextBlock Classes="muted" Text="Escolha qual conta o Claude vai usar." Margin="0,4,0,0" />
        </StackPanel>
        <Button Grid.Column="1" VerticalAlignment="Top" Content="＋ Adicionar conta"
                Command="{Binding OpenAddAccountCommand}" />
      </Grid>

      <!-- Ativa agora -->
      <Border Classes="card" Padding="16,12" Margin="0,0,0,14">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Ellipse Width="10" Height="10" Fill="{Binding ActiveBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
            <Run Text="Ativa agora: " />
            <Run Text="{Binding ActiveName}" FontWeight="SemiBold" />
            <Run Text="{Binding ActiveEmail}" Foreground="{DynamicResource MutedBrush}" />
          </TextBlock>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
            <Border Classes="pill warn" IsVisible="{Binding IsSimulation}"
                    ToolTip.Tip="Nada é alterado de verdade. Desligue em Configurações.">
              <TextBlock Text="Simulação" />
            </Border>
            <Border Classes="pill" Classes.ok="{Binding DesktopPillOk}" Classes.warn="{Binding !DesktopPillOk}">
              <TextBlock Text="{Binding DesktopPillText}" />
            </Border>
            <Border Classes="pill ok">
              <TextBlock Text="Code ✓" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Trocar junto -->
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
        <TextBlock Classes="muted" Text="Trocar junto:" FontSize="13" VerticalAlignment="Center" />
        <Border Classes="seg">
          <StackPanel Orientation="Horizontal">
            <RadioButton Classes="seg" GroupName="scope" Content="Desktop + Code" IsChecked="{Binding IsScopeBoth}" />
            <RadioButton Classes="seg" GroupName="scope" Content="Só Desktop" IsChecked="{Binding IsScopeDesktop}" />
            <RadioButton Classes="seg" GroupName="scope" Content="Só Code" IsChecked="{Binding IsScopeCode}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Cartões -->
      <ItemsControl Name="CardsList" ItemsSource="{Binding Cards}" Margin="0,0,-12,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AccountCardViewModel">
            <Panel Margin="0,0,12,12">
              <Border Classes="card" Padding="16">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Usar esta conta" Command="{Binding UseCommand}" IsEnabled="{Binding CanUse}" />
                    <MenuItem Header="Editar…" Command="{Binding EditCommand}" />
                    <MenuItem Header="Remover da lista…" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanRemove}" />
                  </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Width="42" Height="42" CornerRadius="21" Background="{Binding ColorBrush}">
                      <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,56,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Email}" Classes="small" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                  <WrapPanel>
                    <Border Classes="pill" Margin="0,0,6,6" IsVisible="{Binding HasPlan}">
                      <TextBlock Text="{Binding Plan}" />
                    </Border>
                    <Border Classes="pill" Margin="0,0,6,6">
                      <TextBlock Text="{Binding CodeLabel}" TextTrimming="CharacterEllipsis" />
                    </Border>
                  </WrapPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="{Binding ButtonText}"
                            Classes.primary="{Binding !IsActive}"
                            IsEnabled="{Binding CanUse}"
                            Command="{Binding UseCommand}" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,6" Content="✎"
                            Command="{Binding EditCommand}"
                            ToolTip.Tip="Editar apelido, e-mail e cor"
                            AutomationProperties.Name="Editar" />
                  </Grid>
                </StackPanel>
              </Border>
              <!-- Destaque da conta ativa -->
              <Border CornerRadius="8" BorderThickness="2" BorderBrush="{Binding ColorBrush}"
                      IsVisible="{Binding IsActive}" IsHitTestVisible="False" />
              <TextBlock Text="● ATIVA" Foreground="{Binding ColorBrush}" FontSize="11" FontWeight="SemiBold"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                         IsVisible="{Binding IsActive}" />
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Atividade -->
      <TextBlock Classes="h2" Text="Atividade recente" Margin="0,12,0,8" />
      <Border Classes="card" ClipToBounds="True">
        <Panel>
          <TextBlock Classes="muted" Text="Nenhuma troca ainda." FontSize="13" Margin="14,8"
                     IsVisible="{Binding !HasActivity}" />
          <ItemsControl ItemsSource="{Binding Activity}" Margin="0,-1,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ActivityItem">
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="{Binding Time}" Classes="muted" FontSize="13" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Panel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
